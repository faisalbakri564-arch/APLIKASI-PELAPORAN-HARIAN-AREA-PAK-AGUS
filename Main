import java.time.LocalDate;
import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        LocalDate tanggalHariIni = LocalDate.now();

        // Variabel Penampung Global untuk Dashboard
        String tanggalLaporan = tanggalHariIni.toString();
        String kodeToko = "-";
        String namaToko = "-";
        String statusQuantum = "-";
        int jumlahQuantum = 0;
        double uptActual = 0;
        double uptLastYears = 0;
        int jumlahDefecta = 0;
        int jumlahRiview = 0;
        double jumlahBintang = 0;
        int totalKeseluruhanRiview = 0;
        boolean sudahIsi = false;

        int pilihanMenu = 0;

        // Perulangan Menu Dashboard
        while (pilihanMenu != 3) {
            System.out.println("\n================================================");
            System.out.println("   DASHBOARD LAPORAN HARIAN AREA I MADE AGUS    ");
            System.out.println("================================================");
            System.out.println("1. Isi / Update Laporan Harian");
            System.out.println("2. Lihat Rekap Laporan untuk AM");
            System.out.println("3. Keluar Aplikasi");
            System.out.print("Pilih Menu (1-3): ");
            pilihanMenu = scanner.nextInt();
            scanner.nextLine(); // membersihkan buffer

            if (pilihanMenu == 1) {
                // Form Input Laporan
                System.out.println("        ==============================      ");
                System.out.println("APLIKASI LAPORAN HARIAN AREA I MADE AGUS SUDIANA");
                System.out.println("        ==============================      ");

                System.out.println("Tanggal Laporan     = " + tanggalHariIni);
                System.out.print("Gunakan Tanggal Hari Ini? (y/n) : ");
                String konfirmasiTanggal = scanner.nextLine();
                tanggalLaporan = tanggalHariIni.toString();
                if (konfirmasiTanggal.equalsIgnoreCase("n")){
                    System.out.print("Masukkan tgl laporan (YYYY-MM-DD) : ");
                    tanggalLaporan = scanner.nextLine();
                }
                System.out.println("\n      ==============================      ");
                
                System.out.print("Masukkan Kode Toko  :   ");
                kodeToko = scanner.nextLine();

                System.out.print("Masukkan Nama Toko  :   ");
                namaToko = scanner.nextLine();

                System.out.println("\n===SILAHKAN ISI FORM LAPORAN HARIAN====");

                System.out.print("\n1. Apakah Ada Penginputan Quantum (Y/N) : ");
                statusQuantum = scanner.nextLine();
                jumlahQuantum = 0;
                if (statusQuantum.equalsIgnoreCase("Y")){
                    System.out.print("Tuliskan jumlah pengecekan quantum  :   ");
                    jumlahQuantum = scanner.nextInt();
                    scanner.nextLine();
                }

                System.out.print("2. Input UPT Actual   : ");
                uptActual = scanner.nextDouble();
                System.out.print("Input UPT Last Years : ");
                uptLastYears = scanner.nextDouble();

                System.out.print("3. Input Jumlah Defecta : ");
                jumlahDefecta = scanner.nextInt();
                
                System.out.print("4. Jumlah Review Hari Ini   : ");
                jumlahRiview = scanner.nextInt();
                System.out.print("Total Bintang Hari Ini : ");
                jumlahBintang = scanner.nextDouble();
                System.out.print("Total Keseluruhan Review : ");
                totalKeseluruhanRiview = scanner.nextInt();
                scanner.nextLine(); // membersihkan buffer

                sudahIsi = true;
                System.out.println("\n[Sukses!] Data laporan berhasil disimpan.");

            } else if (pilihanMenu == 2) {
                // Menu Rekap Laporan
                System.out.println("\n==============================");
                System.out.println("    REKAP LAPORAN AM    ");
                System.out.println("==============================");
                
                if (!sudahIsi) {
                    System.out.println("⚠️ Belum ada data laporan yang diisi! Silakan pilih menu 1 terlebih dahulu.");
                } else {
                    System.out.println("Tanggal Laporan     : " + tanggalLaporan);
                    System.out.println("Kode Toko           : " + kodeToko);
                    System.out.println("Nama Toko           : " + namaToko);
                    System.out.println("\n---------------------------");
                    System.out.println("1.   Quantum Cek = " + statusQuantum + " (Jumlah: " + jumlahQuantum + ")");
                    System.out.println("2.   UPT Actual VS LY = " + uptActual + " VS " + uptLastYears);
                    System.out.println("3.   Jumlah Defecta = " + jumlahDefecta);
                    System.out.println("4.   Google Riview = " + jumlahRiview);
                    System.out.println("5.   Google Bintang = " + jumlahBintang);
                    System.out.println("6.   Keseluruhan Riview Google =" + totalKeseluruhanRiview);
                    System.out.println("\n==============================");
                    System.out.println("Data Siap Dikirim Ke AM");
                    System.out.println("==============================");
                }

            } else if (pilihanMenu == 3) {
                System.out.println("\nTerima kasih telah menggunakan aplikasi. Semangat kerjanya!");
            } else {
                System.out.println("\nPilihan tidak valid. Silakan masukkan angka 1, 2, atau 3.");
            }
        }

        scanner.close();
    }
}
